debug.sf.earlyGl.app.duration.60=16666666
debug.sf.earlyGl.app.duration.90=13666666
debug.sf.earlyGl.app.duration.120=11666666
debug.sf.earlyGl.sf.duration=10500000
debug.sf.earlyGl.sf.duration.60=15666666
debug.sf.earlyGl.sf.duration.90=16111111
debug.sf.earlyGl.sf.duration.120=12333333
debug.sf.enable_advanced_sf_phase_offset=1
debug.sf.enable_gl_backpressure=1
