debug.sf.hw=0
debug.sf.latch_unsignaled=1
debug.sf.late.app.duration=16600000
debug.sf.late.app.duration.60=16666666
debug.sf.late.app.duration.90=13666666
debug.sf.late.app.duration.120=11666666
